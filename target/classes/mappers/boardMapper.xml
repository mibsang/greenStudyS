<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.spring.greenStudyS.dao.BoardDAO">
	
	<select id="getTotRecCnt" resultType="int">
		select count(*) from board;
	</select>
	
	<select id="getboardList" resultType="com.spring.greenStudyS.vo.BoardVO">
		select *, timestampdiff(hour, wDate, now()) as hour_diff from board order by idx desc limit #{startIndexNo}, #{pageSize};
	</select>
	
	
	
	
</mapper>